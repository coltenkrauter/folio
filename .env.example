# Folio reads these only when you use AI assistance (folio create --ai).
# Normal invoice generation never requires them and never makes network calls.

# Your OpenRouter API key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# The model used to rewrite line-item wording. Optional; a sensible default is used if unset.
OPENROUTER_MODEL=openai/gpt-4.1-mini
